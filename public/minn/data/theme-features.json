    "custom-background": {
        "type": "object",
        "variadic": false,
        "description": "Custom background if defined by the theme.",
        "show_in_rest": {
            "schema": {
                "description": "Custom background if defined by the theme.",
                "type": [
                    "boolean",
                    "object"
                ],
                "default": false,
                "properties": {
                    "default-image": {
                        "type": "string",
                        "format": "uri"
                    },
                    "default-preset": {
                        "type": "string",
