        "status": "publish",
        "type": "post",
        "link": "https://minn.localhost/zz-block-battery-text/",
        "title": {
            "rendered": "Block battery: text"
        },
        "content": {
            "rendered": "\n<p class=\"wp-block-paragraph\">A plain paragraph with <strong>bold</strong>, <em>italic</em>, and a <a href=\"https://minn.localhost/hello-world/\">link</a>. &#8220;Quoted&#8221; and it&#8217;s texturized&#8230;</p>\n\n\n\n<p class=\"has-text-align-center has-drop-cap has-large-font-size wp-block-paragraph\">Centered, drop cap, large.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Heading two</h2>\n\n\n\n<h3 class=\"wp-block-heading has-text-align-center\">Heading three, centered</h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>First item</li>\n\n\n\n<li>Second item\n<ul class=\"wp-block-list\">\n<li>Nested item</li>\n</ul>\n</li>\n</ul>\n\n\n\n<ol start=\"3\" class=\"wp-block-list\">\n<li>Third</li>\n\n\n\n<li>Fourth</li>\n</ol>\n\n\n\n<blockquote class=\"wp-block-quote is-layout-flow wp-block-quote-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Quoted paragraph.</p>\n<cite>Someone</cite></blockquote>\n\n\n\n<figure class=\"wp-block-pullquote\"><blockquote><p>Pulled quote.</p><cite>A citation</cite></blockquote></figure>\n\n\n\n<pre class=\"wp-block-verse\">Roses are red,\n  violets are blue.</pre>\n\n\n\n<pre class=\"wp-block-preformatted\">Preformatted   text\nkeeps    spacing.</pre>\n\n\n\n<pre class=\"wp-block-code\"><code>function hi() {\n    return \"quotes stay straight\";\n}</code></pre>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\"><summary>Summary line</summary>\n<p class=\"wp-block-paragraph\">Hidden detail.</p>\n</details>\n\n",
            "protected": false
        },
        "excerpt": {
            "rendered": "<p>A plain paragraph with bold, italic, and a link. &#8220;Quoted&#8221; and it&#8217;s texturized&#8230; Centered, drop cap, large. Heading two Heading three, centered Quoted paragraph. Someone Pulled quote. A citation Roses are red, violets are blue. Preformatted text keeps spacing.</p>\n",
            "protected": false
        },
