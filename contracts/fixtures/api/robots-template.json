        "the tag from given directives",
        {
            "true and false": "<meta name='robots' content='max-image-preview:large, zz-true' />\n",
            "strings": "<meta name='robots' content='max-image-preview:large, max-snippet:-1, max-video-preview:, unavailable_after:2030-01-01' />\n",
            "numbers": "<meta name='robots' content='max-image-preview:large, zz-int, zz-float' />\n",
            "a list": "<meta name='robots' content='max-image-preview:large, zz-list' />\n",
            "index with noindex": "<meta name='robots' content='max-image-preview:large, index, noindex' />\n",
            "follow with nofollow": "<meta name='robots' content='max-image-preview:large, follow, nofollow' />\n",
            "quotes": "<meta name='robots' content='max-image-preview:large, zz&quot;q, zz-v:a&#039;b&quot;c&lt;d&gt;' />\n",
            "upper case": "<meta name='robots' content='max-image-preview:large, NoIndex' />\n",
            "nothing": "",
            "heard": {
                "max-image-preview": "large"
            }
        }
