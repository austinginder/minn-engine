            false,
            "<form action=\"{home}/wp-admin/x.php\" method=\"post\">\n<div id=\"request-filesystem-credentials-form\" class=\"request-filesystem-credentials-form\">\n\t<h2 id='request-filesystem-credentials-title'>Connection Information</h2><p id=\"request-filesystem-credentials-desc\">\n\tTo perform the requested action, WordPress needs to access your web server. Please enter your FTP credentials to proceed. If you do not remember your credentials, you should contact your web host.</p>\n<label for=\"hostname\">\n\t<span class=\"field-title\">Hostname</span>\n\t<input name=\"hostname\" type=\"text\" id=\"hostname\" aria-describedby=\"request-filesystem-credentials-desc\" class=\"code\" placeholder=\"example: www.wordpress.org\" value=\"\" />\n</label>\n<div class=\"ftp-username\">\n\t<label for=\"username\">\n\t\t<span class=\"field-title\">FTP Username</span>\n\t\t<input name=\"username\" type=\"text\" id=\"username\" value=\"\" />\n\t</label>\n</div>\n<div class=\"ftp-password\">\n\t<label for=\"password\">\n\t\t<span class=\"field-title\">FTP Password</span>\n\t\t<input name=\"password\" type=\"password\" id=\"password\" value=\"\" spellcheck=\"false\" />\n\t\tThis password will not be stored on the server.\t</label>\n</div>\n<fieldset>\n<legend>Connection Type</legend>\n\t\t<label for=\"ftp\">\n\t\t<input type=\"radio\" name=\"connection_type\" id=\"ftp\" value=\"ftp\"   disabled='disabled' />\n\t\tFTP\t</label>\n\t\t\t<label for=\"ftps\">\n\t\t<input type=\"radio\" name=\"connection_type\" id=\"ftps\" value=\"ftps\"  checked='checked'  disabled='disabled' />\n\t\tFTPS (SSL)\t</label>\n\t\t</fieldset>\n\t\t<p class=\"request-filesystem-credentials-action-buttons\">\n\t\t<input type=\"hidden\" id=\"_fs_nonce\" name=\"_fs_nonce\" value=\"{nonce}\" />\t\t<button class=\"button cancel-button\" data-js-action=\"close\" type=\"button\">Cancel</button>\n\t\t<input type=\"submit\" name=\"upgrade\" id=\"upgrade\" class=\"button button-primary\" value=\"Proceed\"  />\t</p>\n</div>\n</form>\n\t",
