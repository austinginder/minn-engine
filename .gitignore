# Local WordPress reference copy (GPL code; never enters this repo)
wp-reference/

# Local site config (credentials and salts; the FILE SHAPE is the contract,
# the contents are per-site)
public/wp-config.php

# Cove site runtime
logs/
tailscale_port

# OS noise
.DS_Store

# Symlink to the Minn Admin dev plugin's build (its own git repo; developed in parallel)
public/minn/admin

# Browser test deps
tests/browser/node_modules
tests/browser/package-lock.json

# The Minn Admin plugin folder as the reference sees it (its own repo; the engine lists it, never runs it)
public/wp-content/plugins/minn-admin

# The engine writes its failure log here; never a fixture
public/wp-content/debug.log
